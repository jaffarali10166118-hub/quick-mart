<!DOCTYPE html>
<html>
<head>
<div class="header">

  <div class="logo">🛒 QuickMart</div>

  <nav id="nav">
    <a href="#">Home</a>
    <a href="#">Products</a>
    <a href="#">Categories</a>
    <a href="#">Contact</a>
  </nav>

  <div class="search-box">
    <input type="text" placeholder="Search products..." onkeyup="search()">
  </div>

  <div class="right">
    <span class="cart-icon">🛒 <span id="cartCount">0</span></span>
    <button onclick="darkMode()">🌙</button>
    <button onclick="toggleMenu()" class="menu-btn">☰</button>
  </div>

</div>

<!-- ✨ now order like a food item -->
<div class="motto">
  ⚡ Delivering Essentials to Your Doorstep — <span>Within 24 Hours</span>
</div>
<style>
.header{
  position:sticky;
  top:0;
  z-index:1000;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;

  padding:12px 20px;
  background:linear-gradient(90deg,#0f0f0f,#1c1c1c);
  backdrop-filter:blur(10px);
  color:white;
}

.logo{
  font-size:20px;
  font-weight:bold;
}

nav a{
  color:white;
  margin:0 10px;
  text-decoration:none;
  font-size:14px;
  transition:0.3s;
}

nav a:hover{
  color:#2ecc71;
}

.search-box input{
  padding:6px 12px;
  border-radius:20px;
  border:none;
  outline:none;
  width:180px;
}

.right{
  display:flex;
  align-items:center;
  gap:10px;
}

.cart-icon{
  background:#2ecc71;
  padding:5px 10px;
  border-radius:20px;
  font-size:14px;
}

.menu-btn{
  display:none;
  background:none;
  border:none;
  color:white;
  font-size:20px;
}

/* ✨ Motto Styling */
.motto{
  text-align:center;
  padding:8px;
  font-size:14px;
  background:#2ecc71;
  color:white;
  letter-spacing:0.5px;
}

.motto span{
  font-weight:bold;
  text-transform:uppercase;
}

/* 📱 MOBILE */
@media(max-width:768px){

  nav{
    position:absolute;
    top:60px;
    left:0;
    width:100%;
    background:#111;
    display:none;
    flex-direction:column;
    text-align:center;
  }

  nav a{
    padding:10px;
    border-top:1px solid #333;
  }

  .menu-btn{
    display:block;
  }

  .search-box{
    display:none;
  }
</style>
<script>
function toggleMenu(){
  let nav = document.getElementById("nav");
  nav.style.display = (nav.style.display === "flex") ? "none" : "flex";
}

/* Cart system */
let count = localStorage.getItem("cartCount") || 0;
document.getElementById("cartCount").innerText = count;

function buy(){
  count++;
  localStorage.setItem("cartCount", count);
  document.getElementById("cartCount").innerText = count;

  popup.style.display="block";
  setTimeout(()=>popup.style.display="none",2000);
}

/* Save dark mode */
function darkMode(){
  document.body.classList.toggle("dark");
  localStorage.setItem("mode", document.body.classList.contains("dark"));
}

if(localStorage.getItem("mode") === "true"){
  document.body.classList.add("dark");
}
</script>

</header>

<div class="topbar">
<input class="search" placeholder="Search..." onkeyup="search()">
<button onclick="darkMode()">🌙</button>
</div>

<div class="category">
<button onclick="filter('all')">All</button>
<button onclick="filter('electronics')">Electronics</button>
<button onclick="filter('garments')">Garments</button>
<button onclick="filter('kids')">Kids</button>
</div>

<div class="products" id="products">

<!-- ELECTRONICS -->
<script>
for(let i=1;i<=20;i++){
document.write(`
<div class="card electronics">
<span class="star" onclick="toggleStar(this)">⭐</span>
<img src="https://via.placeholder.com/150">
<h4>Mobile Accessory ${i}</h4>
<p>₹${100+i*20}</p>
<p>Free Delivery</p>
<button onclick="buy()">Buy</button>
</div>
`);
}
</script>

<!-- GARMENTS MALE -->
<script>
let male=["Shirt","T-Shirt","Jeans","Jacket","Hoodie","Kurta","Sweater","Blazer","Track Pant","Shorts"];
male.forEach((item,i)=>{
document.write(`
<div class="card garments">
<span class="star" onclick="toggleStar(this)">⭐</span>
<img src="https://via.placeholder.com/150">
<h4>Men ${item}</h4>
<p>₹${500+i*100} | Size: M,L,XL</p>
<button onclick="buy()">Buy</button>
</div>
`);
});
</script>

<!-- GARMENTS FEMALE -->
<script>
let female=["Dress","Top","Saree","Kurti","Skirt","Jeans","Gown","Suit","Tunic","Jacket"];
female.forEach((item,i)=>{
document.write(`
<div class="card garments">
<span class="star" onclick="toggleStar(this)">⭐</span>
<img src="https://via.placeholder.com/150">
<h4>Women ${item}</h4>
<p>₹${600+i*120} | Size: S,M,L</p>
<button onclick="buy()">Buy</button>
</div>
`);
});
</script>

<!-- KIDS -->
<script>
for(let i=1;i<=30;i++){
document.write(`
<div class="card kids">
<span class="star" onclick="toggleStar(this)">⭐</span>
<img src="https://via.placeholder.com/150">
<h4>Kids Product ${i}</h4>
<p>₹${200+i*15}</p>
<button onclick="buy()">Buy</button>
</div>
`);
}
</script>

</div>

<div class="cart">🛒</div>

<div class="popup" id="popup">✅ Order Confirmed (UPI)</div>

<footer>
<p>Free Delivery | 24 Hour Service</p>
<p>Founded by Mr Jaffar Ali</p>
</footer>

<script>
let wishlist = [];

function darkMode(){
document.body.classList.toggle("dark");
}

function buy(){
popup.style.display="block";
setTimeout(()=>popup.style.display="none",2000);
}

function toggleStar(el){
let card = el.parentElement;
let name = card.querySelector("h4").innerText;

if(wishlist.includes(name)){
wishlist = wishlist.filter(item => item !== name);
el.innerHTML = "⭐";
el.style.color = "black";
}else{
wishlist.push(name);
el.innerHTML = "❤️";
el.style.color = "red";
}

sortWishlist();
}

function sortWishlist(){
let container = document.getElementById("products");
let cards = Array.from(container.children);

cards.sort((a,b)=>{
let aName = a.querySelector("h4").innerText;
let bName = b.querySelector("h4").innerText;

return (wishlist.includes(bName) - wishlist.includes(aName));
});

cards.forEach(card => container.appendChild(card));
}

function filter(cat){
let items=document.getElementsByClassName("card");
for(let i=0;i<items.length;i++){
items[i].style.display=(cat=="all"||items[i].classList.contains(cat))?"block":"none";
}
}

function search(){
let input=document.querySelector(".search").value.toLowerCase();
let items=document.querySelectorAll(".card");
items.forEach(el=>{
el.style.display=el.innerText.toLowerCase().includes(input)?"block":"none";
});
}
</script>

</body>
</html>
